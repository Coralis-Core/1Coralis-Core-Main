{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract file",
  "description": "Structure every *.contract.json must follow. Validated by any JSON Schema implementation.",
  "type": "object",
  "required": [
    "capability",
    "version",
    "kind",
    "summary",
    "examples"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*\\.v[0-9]+(\\.[a-z][a-z0-9_]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "enum": [
        "request",
        "event"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "output": {
      "type": "object"
    },
    "payload": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "input": {},
          "output": {},
          "payload": {},
          "error": {
            "type": "string"
          },
          "match": {
            "enum": [
              "contains",
              "schema"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "invalid_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "input": {},
          "payload": {}
        }
      }
    },
    "invalid_payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "input": {},
          "payload": {}
        }
      }
    },
    "idempotent": {
      "type": "boolean",
      "description": "true = repeating this request after it was sent is safe (retry/backup allowed). Default false."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          }
        }
      },
      "then": {
        "required": [
          "input",
          "output"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "payload"
              ]
            },
            {
              "required": [
                "invalid_payloads"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "event"
          }
        }
      },
      "then": {
        "required": [
          "payload"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "input"
              ]
            },
            {
              "required": [
                "output"
              ]
            },
            {
              "required": [
                "invalid_inputs"
              ]
            }
          ]
        }
      }
    }
  ]
}
